PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me
NODE_ENV=development
DEFAULT_REDIRECT_URL=/

# Toggle between a local mock SAML user and a real external IdP.
SAML_MODE=mock
SAML_ENTRY_POINT=https://your-idp.example.com/app/your-app-id/sso/saml
SAML_ISSUER=zephr-saml-poc-local
SAML_CALLBACK_URL=http://localhost:3000/auth/saml/acs
SAML_AUDIENCE=zephr-saml-poc-local
SAML_IDP_ISSUER=http://www.okta.com/exkexample
SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\nYOUR_IDP_CERT\n-----END CERTIFICATE-----"
SAML_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nOPTIONAL_SP_SIGNING_KEY\n-----END PRIVATE KEY-----"
SAML_PUBLIC_CERT="-----BEGIN CERTIFICATE-----\nOPTIONAL_SP_PUBLIC_CERT\n-----END CERTIFICATE-----"
SAML_FORCE_AUTHN=false
SAML_ACCEPTED_CLOCK_SKEW_MS=5000

# Optional mock SAML user attributes.
SAML_MOCK_NAME_ID=00u123example
SAML_MOCK_EMAIL=alex.demo@example.com
SAML_MOCK_GIVEN_NAME=Alex
SAML_MOCK_SURNAME=Demo
SAML_MOCK_COMPANY=Example Media Group
SAML_MOCK_ROLE=marketing-admin
SAML_MOCK_GROUPS=marketing,subscribers
SAML_MOCK_ACCOUNT_ID=acct-demo-123

ZEPHR_MODE=mock
ZEPHR_BASE_URL=https://admin.your-tenant.example
ZEPHR_API_KEY=replace-me
ZEPHR_SITE_ID=your-site-id
ZEPHR_PUBLIC_BASE_URL=https://your-live-site.example
ZEPHR_BROWSER_SDK_URL=https://your-live-site.example/path/to/blaize-front-end-sdk.min.js
ZEPHR_CREATE_ANON_SESSION=false

# Optional wall labels to remind you what to target in Zephr.
ZEPHR_LOGIN_WALL_LABEL=Login Wall
ZEPHR_REGISTRATION_WALL_LABEL=Registration Wall
ZEPHR_PROTECTED_WALL_LABEL=Protected Content Wall
